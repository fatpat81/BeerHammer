    {
      "id": "claim_898749461c6c47e58b56f67680bbf57a",
      "statement": "GET /api/changelog derives its dynamic fields from exactly one query — the ten newest SyncMetadata rows ordered by syncedAt desc — using the newest row's rulesetVersionId for currentRulesetVersion (else the literal '11.1.0-2026-Q3-MFM'), its syncedAt for lastSyncedAt (else new Date()), and the mapped rows for syncRecords.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/routes/changelog.ts#L121-L151",
          "version": "repo-lines-v1:sha256:a8a24a999e3081a01cd2ba47ade72fd4c223b37ec7f009d577ef55cfaa30e134:"
        }
      ]
    },
    {
      "id": "claim_72d9bbca6a584eb6bab4876a05955563",
      "statement": "The changelog's balance-change feed is not data: totalChanges and recentChanges are the hardcoded module-level CURATED_BALANCE_CHANGES array of seven RulesChangeItems (five Space Marines, one Necrons, one Tyranids, all effective 2026-09-15), which no database table populates, so changing it requires a source edit.",
