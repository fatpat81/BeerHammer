    {
      "id": "claim_19fc04d5bdc648329c3d66af4b7429be",
      "statement": "Audit discrepancies come from two producers: validateRoster for structural checks (points limit, DP budget, Rule of Three, orphan attachments) mapped ERROR→RED / otherwise AMBER and code RULE_OF_THREE→DP_VIOLATION / any other code→INVALID_LOADOUT, and the route's own cost-drift check which alone produces POINTS_SHIFT — so category is UI navigation, not rules semantics, and a real DP_EXCEEDED or points-limit breach surfaces under Loadouts & Rules.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/routes/audit.ts#L77-L93",
