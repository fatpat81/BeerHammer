    {
      "id": "claim_25ca2cf95b6147ee90674cc8f5c19836",
      "statement": "The audit route performs point-shift detection itself: it collects every unit's datasheetId, issues a single batched datasheet.findMany({ where: { id: { in: ids } } }), and flags a missing datasheet as RED/INVALID_LOADOUT and a stored unit.pointsCost differing from the live Datasheet.basePoints as AMBER/POINTS_SHIFT with oldValue/newValue, never rewriting the roster snapshot to match current costs.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/routes/audit.ts#L39-L75",
          "version": "repo-lines-v1:sha256:705112d304394048a59e094a0bc8be8338269741af7ecde127a503623309277a:"
