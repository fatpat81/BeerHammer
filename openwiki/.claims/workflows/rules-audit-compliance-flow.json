    {
      "id": "claim_9781d4c514384e1696bcc3454fc36922",
      "statement": "POST /api/rosters/:id/audit is mounted on /api behind requireAuth and its first action is an ownership-scoped lookup userArmy.findFirst({ where: { id, userId: req.userId! } }) that answers 404 NOT_FOUND on a miss, so an unauthenticated guest receives 401 UNAUTHORIZED and a locally synthesized roster id that was never persisted receives 404 — server-side auditing is structurally impossible for guest and local-only rosters.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/index.ts#L55-L60",
          "version": "repo-lines-v1:sha256:60e68e83d35ba9b7af78100cc1c54a0ad5ab33fe6649a6476c8414ae0fc9e5f3:"
