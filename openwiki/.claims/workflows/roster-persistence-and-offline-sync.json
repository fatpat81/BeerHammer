          "version": "repo-lines-v1:sha256:d5ab427ef6d2ede9bf8f0f26f70045bafa033ef13e31adf6183d7dcf1a683610:"
        }
      ]
    },
    {
      "id": "claim_2cc27f99ab774d02bd02e303eb6f5d40",
      "statement": "On the authenticated path the server row becomes the source of truth: fetchRosters accepts only a non-empty remote array, mirrors it wholesale into localStorage via saveStoredRosters, and returns it, silently discarding unsynced local edits; fetchRoster upserts the single remote row into the mirror.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/lib/api.ts#L243-L283",
          "version": "repo-lines-v1:sha256:5bd136a8c03199163bf9d3c86ff082886c1bbf20d5a28dbe0470f569706fba6b:"
        }
      ]
    },
    {
      "id": "claim_6387244b2334496f8691cbf09fc9f0a3",
      "statement": "fetchRosters cannot distinguish 'server says you own nothing' from 'server unreachable' because the remote.length > 0 guard sends an empty list to getStoredRosters(), which itself substitutes DEFAULT_STARTER_ARMY for an absent, non-array or empty value, so a signed-in user with zero rosters can never see an empty list.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/lib/api.ts#L133-L143",
          "version": "repo-lines-v1:sha256:4c4e77d79246d7bf391683fd23abd4ba93c6124f277a31845e1564d124c0939c:"
        },
        {
          "resource": "repo://apps/web/src/lib/api.ts#L243-L255",
