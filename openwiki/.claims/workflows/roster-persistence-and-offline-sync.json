    {
      "id": "claim_e69e6ac5d57a4bba8d48fadf6dd72384",
      "statement": "deleteRoster filters the mirror, saves, then fires the DELETE best-effort and always resolves { deleted: true }; a failed DELETE leaves the row alive in Postgres as a ghost delete that reappears on the next successful read, and DeleteArmyModal's catch branch never runs.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/components/DeleteArmyModal.tsx#L30-L45",
