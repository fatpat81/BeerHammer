        }
      ]
    },
    {
      "id": "claim_ffa6b85813e143328beefef34111c05e",
      "statement": "createRoster tries POST /rosters first and on any failure synthesizes a local army with id army_<Date.now()>_<4-char base36> and an empty payload; either way the object is unshifted into storage and returned, so CreateArmyModal always navigates to /army/<id>/edit without learning whether persistence happened, and its own dead catch block builds a second fallback with a different userId.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/components/CreateArmyModal.tsx#L144-L190",
          "version": "repo-lines-v1:sha256:764a7d1bd6aef101917886c61bdc9e00cb5d013298f20963926c2341c1886cab:"
