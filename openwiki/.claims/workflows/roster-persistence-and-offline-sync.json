    {
      "id": "claim_f7751c5729144ea39e7ee169f05a5df6",
      "statement": "A valid token whose subject has no matching user_profiles row cannot persist a roster: user_armies.user_id carries an ON DELETE CASCADE foreign key to user_profiles and no code path creates those rows, so the write fails with 500 DB_ERROR while the client still reports success.",
