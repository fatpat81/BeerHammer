    {
      "id": "claim_4522964f22d04828898890dccb5a1e3d",
      "statement": "updateRoster is a local-first write-through: it merges the patch onto the stored entry (or onto DEFAULT_STARTER_ARMY), stamps updatedAt from the browser clock and saves localStorage before issuing the PUT, discards the server response body, and returns the locally merged object, so server normalisation never propagates back until the next read.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/lib/api.ts#L327-L370",
          "version": "repo-lines-v1:sha256:bcefafe613887a77b333e1f264b3ad3b15f0730c7b128fa25ad51ec734d6da11:"
        }
      ]
    },
    {
      "id": "claim_3e890148661f4a49947c22d546691687",
      "statement": "The Roster Studio's Saved indicator means 'saved to localStorage': performSave sets saveState to 'saved' in its catch branch as well as its success branch, and auto-save is debounced 1200ms per roster change with manual save and theme change forcing performSave immediately.",
      "evidence": [
