    {
      "id": "claim_0983bb7e22e946149ab92b042f911be2",
      "statement": "buildStorageKeyPrefix returns users/{userId}/rosters/{rosterId}/units/{unitInstanceId}, and the handler appends /card.webp and /thumb.webp. Keys derive solely from identifiers the client already supplies, so a replacement upload overwrites the same two objects in place and deletion relies on the persisted storageKeyPrefix rather than the URLs.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/routes/media.ts#L148-L152",
