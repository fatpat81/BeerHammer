    {
      "id": "claim_e17f9ecb2d7148359bd24b2308f53db4",
      "statement": "The default compose stack runs SeaweedFS (chrislusf/seaweedfs, 'server -dir=/data -s3 -s3.port=9000', service s3, volume s3_data) as the S3-compatible store because MinIO images were removed from Docker Hub/quay.io, and points the API at AWS_ENDPOINT http://s3:9000 with bucket forceorg-miniatures and PUBLIC_CDN_BASE_URL http://localhost:9000/forceorg-miniatures, so the CDN-base URL rule applies in the default deployment.",
      "evidence": [
