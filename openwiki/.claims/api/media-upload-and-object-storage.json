    {
      "id": "claim_6eb5dd49a5444a9baa2118ec5f1edbbc",
      "statement": "processMiniatureUpload seeds one Sharp instance with failOn: 'truncated' and .rotate(), then clones it for two concurrent derivatives: a 400x400 fit-inside, withoutEnlargement card at WebP quality 85 (effort 4, smartSubsample) and a 120x120 fit-cover thumbnail cropped at sharp.strategy.entropy position, encoded WebP quality 80. Corrupt or truncated input therefore rejects before any object is written, and the card branch never upscales while the thumbnail is always exactly 120x120.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/services/miniature-processor.ts#L20-L34",
          "version": "repo-lines-v1:sha256:7b0b312c84724c021b11e4ee640fe29acbd66fb0ceac2c4277aa17a6f3a8bd4b:"
        }
      ]
    },
    {
      "id": "claim_babd149684444f24a47fcd1c02a75d80",
      "statement": "The upload response returns the persisted media record together with a processing block carrying each generated variant's width, height, and sizeBytes as reported by Sharp.",
