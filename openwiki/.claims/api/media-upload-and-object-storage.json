    {
      "id": "claim_1bce8939284241cfa8975b76622f5ca8",
      "statement": "Upload ingest uses a single multer instance with memoryStorage(), a 10 MB fileSize limit, and a mimetype allowlist of image/jpeg, image/png, image/webp, image/heic, image/heif, so raw bytes arrive as file.buffer with no temp files; upload.any() accepts any field name (the web client sends miniature_photo) and the handler uses req.file or the first entry of req.files.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/routes/media.ts#L15-L22",
          "version": "repo-lines-v1:sha256:361901486b2a878231a1dd02c00f55bd0891d572d6b17fda96e6b5aae26a62ff:"
