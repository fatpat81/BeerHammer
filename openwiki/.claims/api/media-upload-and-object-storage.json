        }
      ]
    },
    {
      "id": "claim_b53e0f7b4fbd44f8be762b662b4ea8a0",
      "statement": "Because multer's fileFilter rejects disallowed mimetypes by skipping the file rather than raising a typed error, a non-allowlisted upload surfaces to the client as 400 NO_FILE ('No image file provided') rather than a mimetype-specific error.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/routes/media.ts#L18-L21",
