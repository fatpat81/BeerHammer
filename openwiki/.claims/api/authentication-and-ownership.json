    {
      "id": "claim_e0c01ecbf51a4d3485813542f6890747",
      "statement": "Ownership enforcement is a per-handler, inline Prisma filter with no shared helper: every roster, audit, and media handler calls findFirst({ where: { id, userId: req.userId! } }) (or findMany({ userId }) for the list) and answers 404 NOT_FOUND when no row matches, so a foreign roster is indistinguishable from a missing one and 403 is never emitted. POST /rosters instead assigns ownership by stamping userId from the token onto the created row.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/routes/audit.ts#L25-L34",
          "version": "repo-lines-v1:sha256:c0eeaf515626bf5d321ed47b2c7a66ef21d3a89716c04d0ea39390dc823d33d9:"
