    {
      "id": "claim_b064b1d14672492d90d4420b2ccc737c",
      "statement": "Media ownership is established through the parent roster: the upload handler verifies prisma.userArmy.findFirst({ id: rosterId, userId }) after multer accepts the file and before running Sharp, then stamps userId on the UserUnitMedia upsert and derives object keys from the same identity via buildStorageKeyPrefix (users/{userId}/rosters/{rosterId}/units/{unitInstanceId}). The delete handler scopes both lookup branches by userId before removing S3 objects and the row.",
      "evidence": [
