    {
      "id": "claim_31434c2745474fe29ddbddcf0fb644e3",
      "statement": "The Express app in apps/api/src/index.ts installs, in order: helmet(), cors({ origin: process.env.CORS_ORIGIN || 'http://localhost:3000', credentials: true }), express.json({ limit: '2mb' }), a rate limiter mounted on /api, GET /api/health, then router mounts on /api (datasheets, rosters, media, audit, changelog), a catch-all 404 handler returning NOT_FOUND, and a terminal global error handler; the server listens on process.env.PORT || 4000.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/index.ts#L15-L24",
          "version": "repo-lines-v1:sha256:2dfd790346b9ef5e8810de04e7fcd1bc1c5a410258fb7da3450b1bc65260cbf3:"
