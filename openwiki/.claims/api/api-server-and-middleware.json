    {
      "id": "claim_fe53dec64321412ab206e136f36e141e",
      "statement": "The API-wide rate limiter (express-rate-limit) allows 300 requests per 15-minute window per IP with standardHeaders 'draft-7' and legacyHeaders false, is mounted via app.use('/api', apiLimiter) before the health route (so /api/health is also rate-limited), and on excess returns an envelope-shaped 429 body with error code RATE_LIMIT_EXCEEDED.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/index.ts#L27-L53",
