    {
      "id": "claim_ecb1118334e74c7a96923248a509732e",
      "statement": "Every API response uses one uniform envelope — { success: true, data, meta? } or { success: false, error: { code, message } } — documented in docs/API.md and codified as ApiSuccess/ApiError in docs/OPENAPI.yaml. docs/API.md's 'Error codes' table maps codes to HTTP statuses (UNAUTHORIZED/TOKEN_INVALID 401, NOT_FOUND 404, INVALID_PARAMS/NO_FILE 400, RATE_LIMIT_EXCEEDED 429, INTERNAL_ERROR/DB_ERROR/UPLOAD_ERROR/AUDIT_ERROR 500), while the OpenAPI ApiError enum additionally names DELETE_ERROR, which the docs table folds into the unnamed 500 group.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/routes/media.ts#L160-L160",
          "version": "repo-lines-v1:sha256:d52f17c0d84238cc9e614d9a68fcb33f366c184c480baf4cfec76364cf844471:"
