    {
      "id": "claim_3fd3253fb7084e09b1159772043c4124",
      "statement": "The global ErrorBoundary is a class component that logs '[ErrorBoundary]' with the component stack and swaps in a fallback UI; its 'Try Again' handler only resets local state (setState({ error: null })), so it neither remounts the route nor reloads the page. An optional fallback prop overrides the default UI, and the module also exports a non-boundary InlineError.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/components/ErrorBoundary.tsx#L20-L70",
          "version": "repo-lines-v1:sha256:63ef8b09b729aef74c5637e1d26c3b62385e0873f0aaa9bc510f52b0bd53decd:"
        }
      ]
    },
    {
      "id": "claim_f1f2b862e3bb430bb199b9338beff556",
      "statement": "useAuth() throws 'useAuth must be used within an <AuthProvider>' when the context is null, which enforces that every consumer of auth state is rendered beneath the root layout provider.",
