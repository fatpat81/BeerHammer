    {
      "id": "claim_66e376d52d8c43e384c31260fc8a91fd",
      "statement": "signInAsGuest(callsign?) is synchronous (returns void, no error channel): it normalises the callsign to (callsign || 'Commander').trim() || 'Commander', fabricates a User with app_metadata.provider 'guest' and role/aud 'authenticated', id 'guest_<slug>_<4-char base36 random suffix>' where the slug is the lowercased callsign with non-[a-z0-9] replaced by '_', and a deterministic email '<slug>@forceorg.local', then sets user + isGuest and writes the object to localStorage['forceorg_local_user'], swallowing write failures.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/components/AuthProvider.tsx#L131-L151",
          "version": "repo-lines-v1:sha256:4c84de5a42f7da57080ba934e9e8ba4c62bf35962f9ae760af331cda83c19942:"
        }
      ]
    },
    {
      "id": "claim_1d68ea76ce8b429382fcdad02b2c1c74",
      "statement": "LoginPage supplies the guest callsigns: Quick Launch submits guestCallsign.trim() || 'Battle-Brother', and an error banner offers an 'Enter as Guest Commander instead' button that calls signInAsGuest('Commander'); cloud auth failures are surfaced as copy pointing the user back to Quick Launch.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/components/LoginPage.tsx#L196-L219",
          "version": "repo-lines-v1:sha256:9d8207bb9d7fd463bfe643b366e84fdd192885faf1685f0aa478f0826a02dbc7:"
