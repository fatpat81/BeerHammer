    {
      "id": "claim_708cbe65bec84cb49bbcff8f9913d65b",
      "statement": "Guest persistence is keyed on the randomised user id, not the callsign: api.ts builds storage keys 'forceorg_rosters_<userId>' from localStorage['forceorg_local_user'].id, so signing out and starting a new guest session with the same callsign yields a different key and re-seeds DEFAULT_STARTER_ARMY, orphaning the previous guest's rosters.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/components/AuthProvider.tsx#L131-L151",
          "version": "repo-lines-v1:sha256:4c84de5a42f7da57080ba934e9e8ba4c62bf35962f9ae760af331cda83c19942:"
