    {
      "id": "claim_6556e1cc3a3f436786d5ad37141e10e1",
      "statement": "Guest sign-in never populates session — only user is set — and api.ts's getAuthToken() creates its own Supabase client per request and collapses any failure to null, so guest-mode API calls go out without an Authorization header.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/components/AuthProvider.tsx#L131-L151",
          "version": "repo-lines-v1:sha256:4c84de5a42f7da57080ba934e9e8ba4c62bf35962f9ae760af331cda83c19942:"
        },
