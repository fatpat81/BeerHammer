    {
      "id": "claim_0cd20c3eff3e4a958a1750e870de71aa",
      "statement": "apps/web/src/app/layout.tsx is the only Server Component in the web route tree: it exports metadata/viewport and renders every route inside <div className=\"app-shell\"><ErrorBoundary><AuthProvider>, so pages never mount their own auth or error wrapper but do each mount their own ThemeProvider from @forceorg/ui-theme.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/app/layout.tsx#L6-L48",
          "version": "repo-lines-v1:sha256:3040b55c6a0451b63d66f29b92ba44f0835a5343e51da641822c387f342db387:"
        },
        {
