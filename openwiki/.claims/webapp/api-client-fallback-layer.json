    {
      "id": "claim_2f164f9bf0d140329987aeb61ffc662f",
      "statement": "apiFetch prefixes every call with API_BASE (NEXT_PUBLIC_API_URL, default http://localhost:4000/api, inlined at build time), obtains a Supabase access_token via getAuthToken() which collapses any auth failure into null so the Authorization header is simply omitted for guests, parses the ApiResponse envelope, and throws ApiError(body.error?.code || 'UNKNOWN', body.error?.message, response.status) when !response.ok || !body.success, otherwise resolving body.data.",
      "evidence": [
        {
          "resource": "repo://Dockerfile.web#L33-L33",
          "version": "repo-lines-v1:sha256:611eb5fd770f664c90263ea42fce4052457fea43c61d629e62677370e70ed5c6:"
