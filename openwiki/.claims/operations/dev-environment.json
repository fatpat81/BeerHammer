    {
      "id": "claim_b2e390346ff64b58ae56f5e7b160ea7b",
      "statement": "Stale Next build cache is a known dev failure mode: alternating production builds and dev mode leaves apps/web/.next with mixed output causing globals.css parse 500s, fixed by restarting the web container (or deleting .next on the host path).",
