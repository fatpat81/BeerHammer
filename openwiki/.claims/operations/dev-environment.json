          "version": "repo-lines-v1:sha256:dbe043cadecbcc51e4cce58063880f99e5b4b439ffff9b2afcb115144f05d01c:"
        }
      ]
    },
    {
      "id": "claim_1743585fba854056928d2bd6f0088a76",
      "statement": "The dev seed is idempotent fallback catalog data rather than test fixtures: weapons, datasheets, leader-compatibility and datasheet-weapon links use upsert while stratagems, paint swatches, and abilities do findFirst-then-create, so db-init is safe to re-run on every up and is force-recreated by rebuild.",
      "evidence": [
        {
          "resource": "repo://packages/db-client/prisma/seed.ts#L16-L227",
          "version": "repo-lines-v1:sha256:4f90a1e39470d2d84a192eb95b300aa6c0c08e450e4cabe70123d10b93898457:"
