    },
    {
      "id": "claim_3e4df9528ecc4a1e97e245b2bade671d",
      "statement": "Only the web and API host ports are overridable: WEB_PORT/API_PORT are Compose interpolation variables that simultaneously republish the ports and keep CORS_ORIGIN plus NEXT_PUBLIC_API_URL consistent, while the processes inside still bind 3000 and 4000; dev.sh up explicitly warns about the host port 3000 collision and suggests WEB_PORT=13000.",
      "evidence": [
        {
          "resource": "repo://docker-compose.dev.yml#L27-L31",
          "version": "repo-lines-v1:sha256:111a5faed5936d1ba0a48d41c58f198f6d109c0d9b18e938488ea2b0543e3430:"
