        }
      ]
    },
    {
      "id": "claim_6d61d18f291445579bbbff3531fd8ba7",
      "statement": "dev.sh up runs `up -d`, then polls the web root on ${WEB_PORT:-3000} up to 60 times and curls ${API_PORT:-4000}/api/health, reporting the API as still booting rather than failing when health is not yet available.",
      "evidence": [
        {
          "resource": "repo://scripts/dev.sh#L29-L41",
          "version": "repo-lines-v1:sha256:00ba8e2369482ca6b1341787e9f65212b98fadae9e9ac8dec3d16866b85cc79b:"
        }
      ]
    },
    {
      "id": "claim_ac8b0104632a4026a3443193ae2ea0e7",
      "statement": "The one-shot gates share a single compose `toolchain` service behind `profiles: ['tools']`, so `dev.sh up` never starts it and each one-shot exits with the gate's status; verify runs npm run lint, npm run build, and npm test inside it.",
      "evidence": [
        {
          "resource": "repo://docker-compose.dev.yml#L108-L127",
          "version": "repo-lines-v1:sha256:f4e203b96e54d86a9a8cce40b2401b78422d0d256fc6c5d390638ab39562c117:"
