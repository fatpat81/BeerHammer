        }
      ]
    },
    {
      "id": "claim_34e77fe034284d61893df6ac74f92cf6",
      "statement": "Hot reload works because the repo is bind-mounted at /app while node_modules, apps/web/.next, and the Turbo cache live in named volumes, guaranteeing a host node_modules can never shadow the container's pinned dependencies; Postgres and S3 data volumes survive `down` and are wiped only by `down -v`.",
      "evidence": [
        {
          "resource": "repo://docker-compose.dev.yml#L129-L135",
          "version": "repo-lines-v1:sha256:7c9ade08b091674f7b40e7c15ef133c159864a9e103b44a910cf6dd9e10ec737:"
        },
        {
