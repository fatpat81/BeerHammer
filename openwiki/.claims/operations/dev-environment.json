    },
    {
      "id": "claim_5ff9d636ba1344dfbd2b769e3382e3ab",
      "statement": "db-init is the only schema-mutating service in the dev loop: it depends on postgres being healthy, runs dev-container.sh db under restart: 'no', and after applying migrations and seed executes `tail -f /dev/null` so its container stays up purely to keep logs readable.",
      "evidence": [
        {
          "resource": "repo://docker-compose.dev.yml#L71-L77",
          "version": "repo-lines-v1:sha256:53519d0a5527e3eb7234ac7395aef0b071257f29a83fce5f46095ed3028c4814:"
        },
        {
          "resource": "repo://scripts/dev-container.sh#L10-L21",
