        }
      ]
    },
    {
      "id": "claim_0a7237704d2346dd926e11d47b5587f7",
      "statement": "The db-init wait step is a TCP reachability probe, not a query: dev-wait-for-postgres.js parses host:port from DATABASE_URL and retries net.connect every 2s for 60 attempts, exiting 1 after 120s if postgres never accepts connections.",
      "evidence": [
        {
          "resource": "repo://scripts/dev-wait-for-postgres.js#L1-L29",
          "version": "repo-lines-v1:sha256:021258dfd16bbcf182f47f47c40581a8f511c103f7ad652eb962437c6208d44f:"
        }
      ]
    },
    {
      "id": "claim_aedbe9ac4e414562b906196f0866375e",
      "statement": "db-init applies schema changes with `prisma migrate deploy` (committed migrations only, unlike the root db:migrate script's `prisma migrate dev`), and the seed step is wrapped in `|| echo` so a failing seed is logged as a warning and never blocks environment startup.",
      "evidence": [
        {
          "resource": "repo://package.json#L17-L19",
          "version": "repo-lines-v1:sha256:760608e7617e8eef14cbe0896551911a4d7e265ce2ebfde865b7801aed552fde:"
