    {
      "id": "claim_c0164c0e95d34479948bfcf8c85b2784",
      "statement": "hasDelta() returns true whenever the stored hash is falsy, so an endpoint with no prior SyncMetadata row (or a prior row whose hash was cleared) always registers a delta on its next run even if the payload is byte-identical.",
      "evidence": [
        {
          "resource": "repo://apps/sync-worker/src/checksum.ts#L19-L22",
          "version": "repo-lines-v1:sha256:3092057bc11cbe63d5ea6488c90312b668c78dde8360744ef47b3f3909da515d:"
