    {
      "id": "claim_6a696311060945b09224a83b73801be0",
      "statement": "processEndpoint() reads the latest SyncMetadata row for the endpoint URL (orderBy syncedAt desc), issues a GET with User-Agent ForceOrg-40k-SyncWorker/1.0 and If-None-Match when a stored etag exists, computes a hex SHA-256 of the body with computeContentHash, extracts etag/last-modified via extractCacheHeaders, and compares against the stored contentHash with hasDelta. Equal hashes writes a NO_DELTA row carrying the freshly fetched etag/lastModified/contentHash; differing hashes writes a SUCCESS row.",
      "evidence": [
        {
          "resource": "repo://apps/sync-worker/src/checksum.ts#L8-L35",
          "version": "repo-lines-v1:sha256:88ae35232f807990928143b6983193ccf6c432ac6d912e07b6fb5c722a68341b:"
        },
        {
          "resource": "repo://apps/sync-worker/src/etl-pipeline.ts#L68-L141",
          "version": "repo-lines-v1:sha256:bd8cf597d44075ffad049e594be49e6a1ace5d795519683cad3ff7a88811bc32:"
        }
      ]
    },
    {
      "id": "claim_43a59498d3084152a057e23874fa093c",
      "statement": "fetchEndpoint() returns null for a 304 Not Modified response, and processEndpoint() treats null as no delta, inserting a NO_DELTA row that reuses the previous etag, lastModified and recordCount (contentHash defaulting to empty string).",
      "evidence": [
        {
          "resource": "repo://apps/sync-worker/src/etl-pipeline.ts#L45-L100",
          "version": "repo-lines-v1:sha256:a9bf45f599c08a166b643e840c6d7a281cb8738983109a8995372a63e9554df4:"
