    {
      "id": "claim_ac4e72d7a8f340f2937c8502da651709",
      "statement": "apps/sync-worker is a one-shot job: src/index.ts calls runETLPipeline() once, then exits 0 on success or 1 after logging a fatal error. It contains no loop or timer; all scheduling is external (GitHub Actions cron '0 2 * * *' at 02:00 UTC plus workflow_dispatch, or `docker compose run --rm sync-worker` for a service gated behind the `tools` profile in both dev and prod compose files, which never starts it during `up`).",
      "evidence": [
        {
          "resource": "repo://.github/workflows/wahapedia-sync.yml#L8-L12",
          "version": "repo-lines-v1:sha256:56507fdac5f79c78f0c22e85f3f99f77a3d1dcfdc75aca37c8263b5f9938c472:"
