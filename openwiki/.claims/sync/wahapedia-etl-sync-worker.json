    {
      "id": "claim_55ba78273878483c91b37fc18b56b40e",
      "statement": "The worker's entire write surface is prisma.syncMetadata.create() appending rows to the sync_metadata table (endpoint, lastModified, etag, contentHash, rulesetVersionId, status, recordCount, errorMessage, syncedAt; indexed on endpoint+syncedAt); rows are never updated or deleted, so a feed's current state is its newest row, and the endpoint URL is the lookup key, meaning changing a URL orphans prior history.",
      "evidence": [
        {
          "resource": "repo://apps/sync-worker/src/etl-pipeline.ts#L76-L80",
          "version": "repo-lines-v1:sha256:39ccde97c89b5b708feca781271294349956dd5d113e415239cb28e5d8332d53:"
