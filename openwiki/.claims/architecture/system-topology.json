    {
      "id": "claim_f30a3288c7c54b05bba88580a6b16731",
      "statement": "apps/api/src/index.ts is the single process owning the network boundary: Helmet, CORS limited to CORS_ORIGIN, a 2mb JSON body limit, a 300-request/15-minute per-IP rate limiter mounted on /api, an unauthenticated GET /api/health, and five route mounts (datasheets, rosters, media, audit, changelog) followed by terminal 404 and 500 handlers.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/index.ts#L15-L68",
