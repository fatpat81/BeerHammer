    {
      "id": "claim_96caaac6d155425493d4ef00015979c7",
      "statement": "packages/rules-engine-11e is the repository's only pure business-logic package: @forceorg/types is its sole runtime dependency and its src tree contains no Prisma, HTTP, or React access, which is why it is simultaneously the highest-leverage and the weakest-protected place to put 11th Edition rules.",
      "evidence": [
        {
          "resource": "repo://apps/api/package.json#L12-L16",
