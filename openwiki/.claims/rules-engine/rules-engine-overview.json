    },
    {
      "id": "claim_0be91492092548b4a57b7fa7784f4eff",
      "statement": "The engine never queries the database: callers push external data in as arguments (a LeaderCompatibility[] for attachment legality, a Map<string, Datasheet> for roster validation), which keeps every module testable with literals and makes legality a data change rather than a code change.",
      "evidence": [
        {
