  "claims": [
    {
      "id": "claim_44f0930a71f24592b8c4910ebad58561",
      "statement": "@forceorg/rules-engine-11e exposes its whole surface through a pure re-export barrel (src/index.ts) with no factory, configuration object, or initialisation: four modules (wargear-parser, attachment-resolver, stratagem-filter, detachment-validator) plus the ValidationError type, so a consumer can only ever use one of the named exported functions.",
      "evidence": [
        {
          "resource": "repo://packages/rules-engine-11e/package.json#L5-L6",
          "version": "repo-lines-v1:sha256:c65ce37890176872f502bc6cc275ba5073b26179a2abfbd07920823931c689c9:"
        },
        {
          "resource": "repo://packages/rules-engine-11e/src/index.ts#L1-L36",
