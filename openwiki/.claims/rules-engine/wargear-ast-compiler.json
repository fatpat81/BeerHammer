    {
      "id": "claim_0ba090c4d9a446be858ad432acdd863e",
      "statement": "Exactly five line patterns are recognised and tried in a fixed first-match-wins order: (1) scale-factor 'for every N models ... can replace X with Y' -> REPLACE/TROOPER with scaleFactor; (2) 'any|all|each model can be equipped|may take|can take' -> ADD_ON/ANY with modelLimit 'ALL'; (3) '^N models can replace ... with' -> REPLACE with modelLimit N; (4) passive '<role> X can be replaced with'; (5) active '<role> can replace ... with', both REPLACE with modelLimit 1 and a keyword-sniffed role.",
      "evidence": [
        {
          "resource": "repo://packages/rules-engine-11e/src/wargear-parser.ts#L89-L207",
          "version": "repo-lines-v1:sha256:6caec7445687cfb1244ea01f7145b91ddfac4d6ccaeca4ce29fe3c30957a24b3:"
        }
      ]
    },
    {
