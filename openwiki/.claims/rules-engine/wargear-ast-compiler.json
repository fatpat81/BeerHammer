    {
      "id": "claim_14633215a3114397a977f4a816b2b991",
      "statement": "Before pattern matching, compileWahapediaWargear converts <br> and </li> to newlines, rewrites <li> to a literal bullet, deletes all remaining tags with <[^>]+>, splits on newlines dropping blanks, and strips a leading bullet from each line; tag stripping is purely textual, so inline markup is concatenated into the surrounding line.",
      "evidence": [
        {
          "resource": "repo://packages/rules-engine-11e/src/wargear-parser.ts#L74-L87",
          "version": "repo-lines-v1:sha256:13a6ce4b53a206e7da9bca68f2cc4a097ce85cf77475cc2d0145e79319b686a7:"
        }
      ]
