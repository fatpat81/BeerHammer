FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Prisma needs openssl to detect the correct query engine on slim images
RUN apt-get update -qq && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

# Copy root workspace files
COPY package.json package-lock.json* turbo.json ./
COPY packages/types/package.json ./packages/types/package.json
COPY packages/db-client/package.json ./packages/db-client/package.json
COPY packages/rules-engine-11e/package.json ./packages/rules-engine-11e/package.json
COPY apps/api/package.json ./apps/api/package.json

# Install dependencies
RUN npm ci --ignore-scripts

# Copy source code
COPY packages/types/ ./packages/types/
COPY packages/db-client/ ./packages/db-client/
COPY packages/rules-engine-11e/ ./packages/rules-engine-11e/
COPY apps/api/ ./apps/api/
COPY tsconfig.json ./

# Generate Prisma client & build
RUN npx prisma generate --schema=packages/db-client/prisma/schema.prisma
RUN npm run build --workspace=packages/types
RUN npm run build --workspace=packages/db-client
RUN npm run build --workspace=packages/rules-engine-11e
RUN npm run build --workspace=apps/api

# ── Production Stage ─────────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS runner

WORKDIR /app

# Install Sharp native dependencies
RUN apt-get update -qq && apt-get install -y --no-install-recommends libvips42 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/types/dist ./packages/types/dist
COPY --from=builder /app/packages/types/package.json ./packages/types/package.json
COPY --from=builder /app/packages/db-client/dist ./packages/db-client/dist
COPY --from=builder /app/packages/db-client/package.json ./packages/db-client/package.json
# Prisma schema + migrations for `prisma migrate deploy` at container start
COPY --from=builder /app/packages/db-client/prisma ./packages/db-client/prisma
COPY --from=builder /app/packages/rules-engine-11e/dist ./packages/rules-engine-11e/dist
COPY --from=builder /app/packages/rules-engine-11e/package.json ./packages/rules-engine-11e/package.json
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/package.json ./package.json

# Prisma CLI is needed at container start for `prisma migrate deploy`
COPY --from=builder /app/node_modules/prisma ./node_modules/prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/node_modules/.bin ./node_modules/.bin

ENV NODE_ENV=production
ENV PORT=4000

EXPOSE 4000

COPY apps/api/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
