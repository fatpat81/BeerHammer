# ─────────────────────────────────────────────────────────────────────────────
# ForceOrg-40k — Environment Variables
# Copy to .env.local (web) / apps/api/.env (API) and fill in real values.
# The default deployment is fully self-hosted: PostgreSQL and S3-compatible
# storage run as local containers (see docker-compose.yml).
# ─────────────────────────────────────────────────────────────────────────────

# ── Web App (apps/web/.env.local) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── API Server (apps/api/.env) ───────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Secret used to sign/verify JWTs for write endpoints. External systems that
# need to sync rosters present a token signed with this same secret.
JWT_SECRET=change-me-in-production

# ── Database (PostgreSQL — local container by default) ───────────────────────
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/forceorg_dev?schema=public
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/forceorg_dev?schema=public

# ── Object Storage (S3-compatible, local container by default) ───────────────
# Any S3-compatible endpoint works: the bundled SeaweedFS, MinIO, Garage, etc.
S3_BUCKET=forceorg-media
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ── Sync Worker (apps/sync-worker) ───────────────────────────────────────────
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
