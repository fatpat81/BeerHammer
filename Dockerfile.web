# ─────────────────────────────────────────────────────────────────────────────
# ForceOrg-40k — Next.js Web Application Container (§4.7)
# Multi-stage production build for Next.js App Router frontend
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Prisma needs openssl to detect the correct query engine on slim images
RUN apt-get update -qq && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

# Copy root workspace configuration
COPY package.json package-lock.json* turbo.json ./
COPY packages/types/package.json ./packages/types/package.json
COPY packages/db-client/package.json ./packages/db-client/package.json
COPY packages/rules-engine-11e/package.json ./packages/rules-engine-11e/package.json
COPY packages/ui-theme/package.json ./packages/ui-theme/package.json
COPY apps/web/package.json ./apps/web/package.json

# Install dependencies
RUN npm ci --ignore-scripts

# Copy workspace sources
COPY packages/types/ ./packages/types/
COPY packages/db-client/ ./packages/db-client/
COPY packages/rules-engine-11e/ ./packages/rules-engine-11e/
COPY packages/ui-theme/ ./packages/ui-theme/
COPY apps/web/ ./apps/web/
COPY tsconfig.json ./

# Provide build-time fallback env variables for SSG prerendering
ENV NEXT_PUBLIC_API_URL=http://localhost:4000/api
ENV NEXT_TELEMETRY_DISABLED=1

# Generate Prisma client & build packages in dependency order
RUN npx prisma generate --schema=packages/db-client/prisma/schema.prisma
RUN npm run build --workspace=@forceorg/types
RUN npm run build --workspace=@forceorg/ui-theme
RUN npm run build --workspace=@forceorg/rules-engine-11e
RUN npm run build --workspace=@forceorg/web

# ── Production Stage ─────────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built application and dependencies
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/web ./apps/web
COPY --from=builder /app/package.json ./package.json

USER nextjs

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=@forceorg/web"]
