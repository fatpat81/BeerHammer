      "requiredKeywords": []
    },
    {
      "id": "core-counter-offensive",
      "name": "Counter-Offensive",
      "cpCost": 2,
      "phase": "FIGHT",
      "category": "CORE",
      "description": "Interrupt the combat sequence immediately after an enemy unit has fought to fight with one eligible unit from your army.",
      "requiredKeywords": []
    },
    {
      "id": "core-rapid-ingress",
      "name": "Rapid Ingress",
      "cpCost": 1,
      "phase": "MOVEMENT",
      "category": "CORE",
      "description": "Your unit can arrive from Reserves as if it were the Reinforcements step of your Movement phase, during your opponent's turn.",
