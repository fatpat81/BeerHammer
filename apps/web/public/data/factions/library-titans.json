        "DEEP STRIKE"
      ]
    },
    {
      "id": "core-heroic-intervention",
      "name": "Heroic Intervention",
      "cpCost": 1,
      "phase": "CHARGE",
      "category": "CORE",
      "description": "Declare a counter-charge with one eligible unit after an enemy unit completes a charge move within 6\" of that unit.",
