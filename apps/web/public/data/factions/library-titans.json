        "CHARACTER",
        "VEHICLE",
        "WALKER"
      ]
    },
    {
      "id": "core-smokescreen",
      "name": "Smokescreen",
      "cpCost": 1,
      "phase": "SHOOTING",
      "category": "CORE",
      "description": "Target unit gains the Benefit of Cover and the Stealth ability until the end of the phase.",
      "requiredKeywords": [
        "SMOKE"
      ]
    },
    {
      "id": "core-tank-shock",
      "name": "Tank Shock",
      "cpCost": 1,
      "phase": "CHARGE",
      "category": "CORE",
      "description": "Select one enemy unit within Engagement Range after completing a Charge move; roll dice equal to your vehicle toughness and inflict mortal wounds on 5+.",
      "requiredKeywords": [
        "VEHICLE"
      ]
    },
    {
      "id": "core-go-to-ground",
